class Solution {
public:
    int minAddToMakeValid(string s) {
        int n=s.size();
        int open=0;
        int close=0;
        int cnt=0;
        for(int i=0;i<n;i++){
            if(s[i]=='('){
                open++;
            }
            else close++;
            if(close>open){
                cnt++;
                open++;
            }
        }
        if(open==close) return cnt;
        return abs(open-close)+cnt;
        
    }
};